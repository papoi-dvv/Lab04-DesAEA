<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Neptuno.WPF.Convertidores">

    <!-- ==================== Convertidores ==================== -->
    <conv:InversorBooleano x:Key="InversorBooleano" />
    <conv:BooleanoAVisibilidad x:Key="BooleanoAVisibilidad" />
    <conv:BooleanoAVisibilidadInverso x:Key="BooleanoAVisibilidadInverso" />
    <conv:DescuentoAPorcentaje x:Key="DescuentoAPorcentaje" />

    <!-- ==================== Paleta ==================== -->
    <Color x:Key="ColorPrimario">#1D4E89</Color>
    <Color x:Key="ColorPrimarioClaro">#E8EEF6</Color>
    <Color x:Key="ColorBorde">#D6DCE5</Color>
    <Color x:Key="ColorTexto">#1F2933</Color>
    <Color x:Key="ColorTextoSuave">#5B6672</Color>
    <Color x:Key="ColorPeligro">#B3261E</Color>
    <Color x:Key="ColorFondo">#F5F7FA</Color>

    <SolidColorBrush x:Key="PincelPrimario" Color="{StaticResource ColorPrimario}" />
    <SolidColorBrush x:Key="PincelPrimarioClaro" Color="{StaticResource ColorPrimarioClaro}" />
    <SolidColorBrush x:Key="PincelBorde" Color="{StaticResource ColorBorde}" />
    <SolidColorBrush x:Key="PincelTexto" Color="{StaticResource ColorTexto}" />
    <SolidColorBrush x:Key="PincelTextoSuave" Color="{StaticResource ColorTextoSuave}" />
    <SolidColorBrush x:Key="PincelPeligro" Color="{StaticResource ColorPeligro}" />
    <SolidColorBrush x:Key="PincelFondo" Color="{StaticResource ColorFondo}" />

    <!-- ==================== Tipografía ==================== -->
    <Style x:Key="TituloSeccion" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PincelPrimario}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Etiqueta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource PincelTextoSuave}" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <Style x:Key="TextoEstado" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource PincelTextoSuave}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ==================== Controles de entrada ==================== -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="BorderBrush" Value="{StaticResource PincelBorde}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ==================== Botones ==================== -->
    <Style x:Key="BotonBase" TargetType="Button">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Contenedor"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Contenedor" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Contenedor" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource PincelPrimario}" />
        <Setter Property="BorderBrush" Value="{StaticResource PincelPrimario}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource PincelBorde}" />
        <Setter Property="Foreground" Value="{StaticResource PincelTexto}" />
    </Style>

    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource PincelPeligro}" />
        <Setter Property="Foreground" Value="{StaticResource PincelPeligro}" />
    </Style>

    <!-- ==================== Grillas ==================== -->
    <Style TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource PincelBorde}" />
        <Setter Property="BorderBrush" Value="{StaticResource PincelBorde}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="RowHeight" Value="28" />
        <Setter Property="AlternatingRowBackground" Value="#FAFBFC" />
    </Style>

    <!-- Alineación a la derecha para columnas de importes y cantidades -->
    <Style x:Key="CeldaNumerica" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="CeldaImporte" TargetType="TextBlock" BasedOn="{StaticResource CeldaNumerica}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource PincelPrimarioClaro}" />
        <Setter Property="Foreground" Value="{StaticResource PincelPrimario}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderBrush" Value="{StaticResource PincelBorde}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>

    <!-- ==================== Contenedores ==================== -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource PincelBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="BarraHerramientas" TargetType="Border">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource PincelBorde}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10" />
    </Style>

</ResourceDictionary>
