<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!--
      Cadena de conexión a NeptunoDB.
      Si SQL Server está en otra instancia, cambiar únicamente el atributo
      Server (por ejemplo: Server=localhost;  o  Server=MIPC\SQLEXPRESS02;).
      TrustServerCertificate=True es necesario porque SQL Server Express usa
      un certificado autofirmado y el driver moderno valida TLS por defecto.
    -->
    <add name="NeptunoDB"
         connectionString="Server=.\SQLEXPRESS;Database=NeptunoDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
