<UserControl x:Class="Neptuno.WPF.Vistas.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Neptuno.WPF.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProveedoresViewModel}"
             d:DesignHeight="560" d:DesignWidth="1180">

    <DockPanel>

        <!-- Acciones y filtros de búsqueda -->
        <Border DockPanel.Dock="Top" Style="{StaticResource BarraHerramientas}" Margin="0,0,0,10">
            <StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Nuevo" Style="{StaticResource BotonPrimario}"
                            Command="{Binding NuevoCommand}" />
                    <Button Content="Editar" Style="{StaticResource BotonSecundario}"
                            Command="{Binding EditarCommand}" />
                    <Button Content="Eliminar" Style="{StaticResource BotonPeligro}"
                            Command="{Binding EliminarCommand}" />
                    <Button Content="Refrescar" Style="{StaticResource BotonSecundario}"
                            Command="{Binding RefrescarCommand}" />
                </StackPanel>

                <Separator Margin="0,0,0,10" />

                <!--
                    Búsqueda de proveedores por nombre de contacto y ciudad.
                    Ambos campos son opcionales y se combinan entre sí.
                -->
                <Grid IsEnabled="{Binding EnEdicion, Converter={StaticResource InversorBooleano}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Contacto:" VerticalAlignment="Center"
                               Margin="0,0,8,0" Style="{StaticResource TextoEstado}" />
                    <TextBox Grid.Column="1" Margin="0,0,16,0"
                             Text="{Binding FiltroNombreContacto, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Busca coincidencias parciales en el nombre del contacto">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding BuscarCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <TextBlock Grid.Column="2" Text="Ciudad:" VerticalAlignment="Center"
                               Margin="0,0,8,0" Style="{StaticResource TextoEstado}" />
                    <TextBox Grid.Column="3" Margin="0,0,16,0"
                             Text="{Binding FiltroCiudad, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Busca coincidencias parciales en la ciudad">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding BuscarCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button Content="Buscar" Style="{StaticResource BotonPrimario}"
                                Command="{Binding BuscarCommand}" />
                        <Button Content="Limpiar" Style="{StaticResource BotonSecundario}"
                                Command="{Binding LimpiarFiltrosCommand}" />
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>

        <!-- Estado -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource BarraHerramientas}" Margin="0,10,0,0">
            <TextBlock Text="{Binding Mensaje}" Style="{StaticResource TextoEstado}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding Seleccionado, Mode=TwoWay}"
                      IsEnabled="{Binding EnEdicion, Converter={StaticResource InversorBooleano}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ProveedorID}" Width="55" />
                    <DataGridTextColumn Header="Compañía" Binding="{Binding CompaniaNombre}" Width="210" />
                    <DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto}" Width="150" />
                    <DataGridTextColumn Header="Cargo" Binding="{Binding CargoContacto}" Width="170" />
                    <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="110" />
                    <DataGridTextColumn Header="País" Binding="{Binding Pais}" Width="80" />
                    <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="120" />
                    <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Formulario -->
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Width="380" Margin="12,0,0,0"
                    Visibility="{Binding EnEdicion, Converter={StaticResource BooleanoAVisibilidad}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Editable}">

                        <TextBlock Text="Datos del proveedor" Style="{StaticResource TituloSeccion}" />

                        <TextBlock Text="Compañía *" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding CompaniaNombre, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="60" />

                        <TextBlock Text="Nombre de contacto" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding NombreContacto, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="40" />

                        <TextBlock Text="Cargo del contacto" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding CargoContacto, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="40" />

                        <TextBlock Text="Dirección" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="80" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ciudad" Style="{StaticResource Etiqueta}" />
                                <TextBox Text="{Binding Ciudad, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="30" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Código postal" Style="{StaticResource Etiqueta}" />
                                <TextBox Text="{Binding CodigoPostal, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="10" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="País" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding Pais, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="30" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Teléfono" Style="{StaticResource Etiqueta}" />
                                <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="24" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fax" Style="{StaticResource Etiqueta}" />
                                <TextBox Text="{Binding Fax, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="24" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Guardar" Style="{StaticResource BotonPrimario}"
                                    Command="{Binding DataContext.GuardarCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                                    Command="{Binding DataContext.CancelarCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </DockPanel>
</UserControl>
