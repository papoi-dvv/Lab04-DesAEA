<UserControl x:Class="Neptuno.WPF.Vistas.PedidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Neptuno.WPF.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PedidosViewModel}"
             d:DesignHeight="620" d:DesignWidth="1220">

    <DockPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource BarraHerramientas}" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Nuevo" Style="{StaticResource BotonPrimario}"
                        Command="{Binding NuevoCommand}" />
                <Button Content="Editar" Style="{StaticResource BotonSecundario}"
                        Command="{Binding EditarCommand}" />
                <Button Content="Eliminar" Style="{StaticResource BotonPeligro}"
                        Command="{Binding EliminarCommand}" />
                <Button Content="Refrescar" Style="{StaticResource BotonSecundario}"
                        Command="{Binding RefrescarCommand}" />
                <TextBlock Text="El detalle se edita después de grabar la cabecera del pedido."
                           Style="{StaticResource TextoEstado}" Margin="14,0,0,0" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource BarraHerramientas}" Margin="0,10,0,0">
            <TextBlock Text="{Binding Mensaje}" Style="{StaticResource TextoEstado}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Maestro y detalle -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="150" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4*" MinHeight="200" />
                </Grid.RowDefinitions>

                <!-- Cabeceras de pedido -->
                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding Seleccionado, Mode=TwoWay}"
                          IsEnabled="{Binding EnEdicion, Converter={StaticResource InversorBooleano}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pedido" Binding="{Binding PedidoID}" Width="70" />
                        <DataGridTextColumn Header="Fecha"
                                            Binding="{Binding FechaPedido, StringFormat=dd/MM/yyyy}" Width="95" />
                        <DataGridTextColumn Header="Cliente" Binding="{Binding NombreCliente}"
                                            Width="1.3*" MinWidth="180" />
                        <DataGridTextColumn Header="Empleado" Binding="{Binding NombreEmpleado}"
                                            Width="*" MinWidth="160" />
                        <DataGridTextColumn Header="Requerida"
                                            Binding="{Binding FechaRequerida, StringFormat=dd/MM/yyyy}" Width="95" />
                        <DataGridTextColumn Header="Envío"
                                            Binding="{Binding FechaEnvio, StringFormat=dd/MM/yyyy}" Width="95" />
                        <DataGridTextColumn Header="Destino" Binding="{Binding CiudadDestino}" Width="110" />
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding Total, StringFormat='S/ {0:N2}'}"
                                            Width="120"
                                            ElementStyle="{StaticResource CeldaImporte}" />
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                              Background="Transparent" />

                <!-- Detalle del pedido seleccionado -->
                <Border Grid.Row="2" Style="{StaticResource Tarjeta}">
                    <DockPanel>

                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource TituloSeccion}">
                            <Run Text="Detalle del pedido" />
                            <Run Text="{Binding Seleccionado.PedidoID, StringFormat='#{0}', Mode=OneWay}" />
                        </TextBlock>

                        <!-- Alta de líneas -->
                        <Border DockPanel.Dock="Top" Background="{StaticResource PincelPrimarioClaro}"
                                CornerRadius="4" Padding="10" Margin="0,0,0,10"
                                IsEnabled="{Binding EnEdicion, Converter={StaticResource InversorBooleano}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="Auto" />
                                    <!-- Relleno: mantiene los controles agrupados a la izquierda -->
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Producto" Style="{StaticResource Etiqueta}" />
                                    <ComboBox ItemsSource="{Binding ProductosDisponibles}"
                                              DisplayMemberPath="NombreProducto"
                                              SelectedItem="{Binding ProductoParaAgregar, Mode=TwoWay}"
                                              Margin="0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cantidad" Style="{StaticResource Etiqueta}" />
                                    <TextBox Text="{Binding CantidadParaAgregar,
                                                    UpdateSourceTrigger=PropertyChanged}" Margin="0" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Precio (S/)" Style="{StaticResource Etiqueta}" />
                                    <TextBox Text="{Binding PrecioParaAgregar,
                                                    UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                             Margin="0" />
                                </StackPanel>

                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Descuento" Style="{StaticResource Etiqueta}" />
                                    <TextBox Text="{Binding DescuentoParaAgregar,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0"
                                             ToolTip="Valor entre 0 y 1. Por ejemplo 0.05 equivale a 5 %" />
                                </StackPanel>

                                <StackPanel Grid.Column="8" Orientation="Horizontal"
                                            VerticalAlignment="Bottom">
                                    <Button Content="Agregar" Style="{StaticResource BotonPrimario}"
                                            Command="{Binding AgregarDetalleCommand}" />
                                    <Button Content="Quitar" Style="{StaticResource BotonPeligro}"
                                            Command="{Binding EliminarDetalleCommand}" />
                                </StackPanel>

                            </Grid>
                        </Border>

                        <!-- Total del detalle -->
                        <Border DockPanel.Dock="Bottom" Padding="0,8,4,0">
                            <TextBlock HorizontalAlignment="Right" FontSize="13">
                                <Run Text="Total del pedido:" Foreground="#5B6672" />
                                <Run Text="{Binding TotalDetalle, StringFormat='S/ {0:N2}', Mode=OneWay}"
                                     FontWeight="Bold" Foreground="#1D4E89" />
                            </TextBlock>
                        </Border>

                        <DataGrid ItemsSource="{Binding Detalle}"
                                  SelectedItem="{Binding DetalleSeleccionado, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Precio"
                                                    Binding="{Binding PrecioUnidad, StringFormat='S/ {0:N2}'}"
                                                    Width="110"
                                                    ElementStyle="{StaticResource CeldaNumerica}" />
                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}"
                                                    Width="90"
                                                    ElementStyle="{StaticResource CeldaNumerica}" />
                                <DataGridTextColumn Header="Descuento"
                                                    Binding="{Binding Descuento,
                                                    Converter={StaticResource DescuentoAPorcentaje}}"
                                                    Width="100"
                                                    ElementStyle="{StaticResource CeldaNumerica}" />
                                <DataGridTextColumn Header="Subtotal"
                                                    Binding="{Binding Subtotal, StringFormat='S/ {0:N2}'}"
                                                    Width="120"
                                                    ElementStyle="{StaticResource CeldaImporte}" />
                            </DataGrid.Columns>
                        </DataGrid>

                    </DockPanel>
                </Border>

            </Grid>

            <!-- Formulario de cabecera -->
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Width="360" Margin="12,0,0,0"
                    Visibility="{Binding EnEdicion, Converter={StaticResource BooleanoAVisibilidad}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Datos del pedido" Style="{StaticResource TituloSeccion}" />

                        <StackPanel DataContext="{Binding Editable}">

                            <TextBlock Text="Cliente" Style="{StaticResource Etiqueta}" />
                            <ComboBox ItemsSource="{Binding DataContext.Clientes,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      DisplayMemberPath="Empresa"
                                      SelectedValuePath="ClienteID"
                                      SelectedValue="{Binding ClienteID, Mode=TwoWay}" />

                            <TextBlock Text="Empleado" Style="{StaticResource Etiqueta}" />
                            <ComboBox ItemsSource="{Binding DataContext.Empleados,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      DisplayMemberPath="NombreCompleto"
                                      SelectedValuePath="EmpleadoID"
                                      SelectedValue="{Binding EmpleadoID, Mode=TwoWay}" />

                            <TextBlock Text="Transportista" Style="{StaticResource Etiqueta}" />
                            <ComboBox ItemsSource="{Binding DataContext.Transportistas,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      DisplayMemberPath="CompaniaNombre"
                                      SelectedValuePath="TransportistaID"
                                      SelectedValue="{Binding TransportistaID, Mode=TwoWay}" />

                            <TextBlock Text="Fecha del pedido *" Style="{StaticResource Etiqueta}" />
                            <DatePicker SelectedDate="{Binding FechaPedido, Mode=TwoWay}" />

                            <TextBlock Text="Fecha requerida" Style="{StaticResource Etiqueta}" />
                            <DatePicker SelectedDate="{Binding FechaRequerida, Mode=TwoWay}" />

                            <TextBlock Text="Fecha de envío" Style="{StaticResource Etiqueta}" />
                            <DatePicker SelectedDate="{Binding FechaEnvio, Mode=TwoWay}" />

                            <TextBlock Text="Destinatario" Style="{StaticResource Etiqueta}" />
                            <TextBox Text="{Binding Destinatario, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="60" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ciudad destino" Style="{StaticResource Etiqueta}" />
                                    <TextBox Text="{Binding CiudadDestino,
                                                    UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="País destino" Style="{StaticResource Etiqueta}" />
                                    <TextBox Text="{Binding PaisDestino,
                                                    UpdateSourceTrigger=PropertyChanged}" MaxLength="30" />
                                </StackPanel>
                            </Grid>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Guardar" Style="{StaticResource BotonPrimario}"
                                    Command="{Binding GuardarCommand}" />
                            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                                    Command="{Binding CancelarCommand}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </DockPanel>
</UserControl>
