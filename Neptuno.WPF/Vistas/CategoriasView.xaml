<UserControl x:Class="Neptuno.WPF.Vistas.CategoriasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Neptuno.WPF.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CategoriasViewModel}"
             d:DesignHeight="560" d:DesignWidth="1100">

    <DockPanel>

        <!-- Barra de acciones -->
        <Border DockPanel.Dock="Top" Style="{StaticResource BarraHerramientas}" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Nuevo" Style="{StaticResource BotonPrimario}"
                        Command="{Binding NuevoCommand}" />
                <Button Content="Editar" Style="{StaticResource BotonSecundario}"
                        Command="{Binding EditarCommand}" />
                <Button Content="Eliminar" Style="{StaticResource BotonPeligro}"
                        Command="{Binding EliminarCommand}" />
                <Button Content="Refrescar" Style="{StaticResource BotonSecundario}"
                        Command="{Binding RefrescarCommand}" />
            </StackPanel>
        </Border>

        <!-- Estado -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource BarraHerramientas}" Margin="0,10,0,0">
            <TextBlock Text="{Binding Mensaje}" Style="{StaticResource TextoEstado}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Listado -->
            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding Seleccionado, Mode=TwoWay}"
                      IsEnabled="{Binding EnEdicion, Converter={StaticResource InversorBooleano}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding CategoriaID}" Width="60" />
                    <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}" Width="220" />
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Formulario -->
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Width="360" Margin="12,0,0,0"
                    Visibility="{Binding EnEdicion, Converter={StaticResource BooleanoAVisibilidad}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Editable}">

                        <TextBlock Text="Datos de la categoría" Style="{StaticResource TituloSeccion}" />

                        <TextBlock Text="Nombre *" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding NombreCategoria, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="30" />

                        <TextBlock Text="Descripción" Style="{StaticResource Etiqueta}" />
                        <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="200" Height="90"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Guardar" Style="{StaticResource BotonPrimario}"
                                    Command="{Binding DataContext.GuardarCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                                    Command="{Binding DataContext.CancelarCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </DockPanel>
</UserControl>
