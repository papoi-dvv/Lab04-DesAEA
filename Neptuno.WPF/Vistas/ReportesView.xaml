<UserControl x:Class="Neptuno.WPF.Vistas.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Neptuno.WPF.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReportesViewModel}"
             d:DesignHeight="580" d:DesignWidth="1220">

    <DockPanel>

        <!-- Filtros de fecha -->
        <Border DockPanel.Dock="Top" Style="{StaticResource BarraHerramientas}" Margin="0,0,0,10">
            <StackPanel>

                <TextBlock Text="Detalles de pedidos por intervalo de fechas"
                           Style="{StaticResource TituloSeccion}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Desde:" VerticalAlignment="Center"
                               Margin="0,0,8,0" Style="{StaticResource TextoEstado}" />
                    <DatePicker Grid.Column="1" Margin="0,0,16,0"
                                SelectedDate="{Binding FechaInicio, Mode=TwoWay}" />

                    <TextBlock Grid.Column="2" Text="Hasta:" VerticalAlignment="Center"
                               Margin="0,0,8,0" Style="{StaticResource TextoEstado}" />
                    <DatePicker Grid.Column="3" Margin="0,0,16,0"
                                SelectedDate="{Binding FechaFin, Mode=TwoWay}" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Button Content="Generar" Style="{StaticResource BotonPrimario}"
                                Command="{Binding GenerarCommand}" />
                        <Button Content="Ver todo" Style="{StaticResource BotonSecundario}"
                                Command="{Binding LimpiarCommand}"
                                ToolTip="Quita los filtros de fecha y muestra todo el histórico" />
                        <Button Content="Exportar CSV" Style="{StaticResource BotonSecundario}"
                                Command="{Binding ExportarCsvCommand}" />
                    </StackPanel>

                </Grid>
            </StackPanel>
        </Border>

        <!-- Totales y estado -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource BarraHerramientas}" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Mensaje}"
                           Style="{StaticResource TextoEstado}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Margin="0,0,20,0" VerticalAlignment="Center">
                        <Run Text="Pedidos:" Foreground="#5B6672" />
                        <Run Text="{Binding PedidosDistintos, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Margin="0,0,20,0" VerticalAlignment="Center">
                        <Run Text="Unidades:" Foreground="#5B6672" />
                        <Run Text="{Binding UnidadesTotales, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" FontSize="14">
                        <Run Text="Total:" Foreground="#5B6672" />
                        <Run Text="{Binding TotalGeneral, StringFormat='S/ {0:N2}', Mode=OneWay}"
                             FontWeight="Bold" Foreground="#1D4E89" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Resultados -->
        <DataGrid ItemsSource="{Binding Resultados}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pedido" Binding="{Binding PedidoID}" Width="70" />
                <DataGridTextColumn Header="Fecha"
                                    Binding="{Binding FechaPedido, StringFormat=dd/MM/yyyy}" Width="95" />
                <DataGridTextColumn Header="Cliente" Binding="{Binding NombreCliente}"
                                    Width="1.3*" MinWidth="160" />
                <DataGridTextColumn Header="Empleado" Binding="{Binding NombreEmpleado}"
                                    Width="1.2*" MinWidth="150" />
                <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}"
                                    Width="1.5*" MinWidth="170" />
                <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}"
                                    Width="*" MinWidth="120" />
                <DataGridTextColumn Header="Precio"
                                    Binding="{Binding PrecioUnidad, StringFormat='S/ {0:N2}'}" Width="95"
                                    ElementStyle="{StaticResource CeldaNumerica}" />
                <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="60"
                                    ElementStyle="{StaticResource CeldaNumerica}" />
                <DataGridTextColumn Header="Desc."
                                    Binding="{Binding Descuento,
                                    Converter={StaticResource DescuentoAPorcentaje}}" Width="70"
                                    ElementStyle="{StaticResource CeldaNumerica}" />
                <DataGridTextColumn Header="Subtotal"
                                    Binding="{Binding Subtotal, StringFormat='S/ {0:N2}'}" Width="110"
                                    ElementStyle="{StaticResource CeldaImporte}" />
                <DataGridTextColumn Header="Destino" Binding="{Binding CiudadDestino}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
