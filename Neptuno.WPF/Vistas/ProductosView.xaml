<UserControl x:Class="Neptuno.WPF.Vistas.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Neptuno.WPF.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProductosViewModel}"
             d:DesignHeight="560" d:DesignWidth="1180">

    <DockPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource BarraHerramientas}" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Nuevo" Style="{StaticResource BotonPrimario}"
                        Command="{Binding NuevoCommand}" />
                <Button Content="Editar" Style="{StaticResource BotonSecundario}"
                        Command="{Binding EditarCommand}" />
                <Button Content="Eliminar" Style="{StaticResource BotonPeligro}"
                        Command="{Binding EliminarCommand}" />
                <Button Content="Refrescar" Style="{StaticResource BotonSecundario}"
                        Command="{Binding RefrescarCommand}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource BarraHerramientas}" Margin="0,10,0,0">
            <TextBlock Text="{Binding Mensaje}" Style="{StaticResource TextoEstado}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding Seleccionado, Mode=TwoWay}"
                      IsEnabled="{Binding EnEdicion, Converter={StaticResource InversorBooleano}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ProductoID}" Width="55" />
                    <!-- Anchos proporcionales: el espacio sobrante se reparte entre
                         las tres columnas de texto en vez de acumularse en una sola. -->
                    <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}"
                                        Width="2*" MinWidth="180" />
                    <DataGridTextColumn Header="Categoría" Binding="{Binding NombreCategoria}"
                                        Width="1.2*" MinWidth="120" />
                    <DataGridTextColumn Header="Proveedor" Binding="{Binding NombreProveedor}"
                                        Width="1.8*" MinWidth="160" />
                    <DataGridTextColumn Header="Presentación" Binding="{Binding CantidadPorUnidad}" Width="110" />
                    <DataGridTextColumn Header="Precio"
                                        Binding="{Binding PrecioUnidad, StringFormat='S/ {0:N2}'}"
                                        Width="100"
                                        ElementStyle="{StaticResource CeldaImporte}" />
                    <DataGridTextColumn Header="Stock" Binding="{Binding UnidadesEnExistencia}"
                                        Width="70" ElementStyle="{StaticResource CeldaNumerica}" />
                    <DataGridTextColumn Header="Pedido" Binding="{Binding UnidadesEnPedido}"
                                        Width="70" ElementStyle="{StaticResource CeldaNumerica}" />
                    <DataGridTextColumn Header="Reorden" Binding="{Binding NivelDeReorden}"
                                        Width="80" ElementStyle="{StaticResource CeldaNumerica}" />
                    <DataGridCheckBoxColumn Header="Descont." Binding="{Binding Descontinuado}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Formulario -->
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Width="380" Margin="12,0,0,0"
                    Visibility="{Binding EnEdicion, Converter={StaticResource BooleanoAVisibilidad}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Datos del producto" Style="{StaticResource TituloSeccion}" />

                        <StackPanel DataContext="{Binding Editable}">

                            <TextBlock Text="Nombre *" Style="{StaticResource Etiqueta}" />
                            <TextBox Text="{Binding NombreProducto, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="60" />

                            <TextBlock Text="Categoría" Style="{StaticResource Etiqueta}" />
                            <ComboBox ItemsSource="{Binding DataContext.Categorias,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      DisplayMemberPath="NombreCategoria"
                                      SelectedValuePath="CategoriaID"
                                      SelectedValue="{Binding CategoriaID, Mode=TwoWay}" />

                            <TextBlock Text="Proveedor" Style="{StaticResource Etiqueta}" />
                            <ComboBox ItemsSource="{Binding DataContext.Proveedores,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      DisplayMemberPath="CompaniaNombre"
                                      SelectedValuePath="ProveedorID"
                                      SelectedValue="{Binding ProveedorID, Mode=TwoWay}" />

                            <TextBlock Text="Cantidad por unidad" Style="{StaticResource Etiqueta}" />
                            <TextBox Text="{Binding CantidadPorUnidad, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="30"
                                     ToolTip="Por ejemplo: 500 g, 24 unidades, 1 L" />

                            <TextBlock Text="Precio unitario (S/) *" Style="{StaticResource Etiqueta}" />
                            <TextBox Text="{Binding PrecioUnidad, UpdateSourceTrigger=PropertyChanged,
                                            StringFormat=N2}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Unid. en existencia" Style="{StaticResource Etiqueta}" />
                                    <TextBox Text="{Binding UnidadesEnExistencia,
                                                    UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Unid. en pedido" Style="{StaticResource Etiqueta}" />
                                    <TextBox Text="{Binding UnidadesEnPedido,
                                                    UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Nivel de reorden" Style="{StaticResource Etiqueta}" />
                            <TextBox Text="{Binding NivelDeReorden, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox Content="Producto descontinuado"
                                      IsChecked="{Binding Descontinuado, Mode=TwoWay}" />

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Guardar" Style="{StaticResource BotonPrimario}"
                                    Command="{Binding GuardarCommand}" />
                            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}"
                                    Command="{Binding CancelarCommand}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </DockPanel>
</UserControl>
